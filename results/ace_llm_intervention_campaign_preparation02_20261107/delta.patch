+            return read(path)
+        with patch.object(paired.os, 'link', side_effect=interrupted), patch.object(Path, 'read_bytes', unreadable):
+            with self.assertRaises(KeyboardInterrupt) as raised: self.finalize()
+        self.assertIs(raised.exception, fault)
+        self.assertTrue((self.path/'finalization.json').is_file())
+        diagnostic = json.loads((self.path/'private/publication-uncertain.json').read_bytes())
