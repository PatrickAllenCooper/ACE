+        self.assertEqual(terminal.read_bytes(), (self.path/'finalization.candidate.json').read_bytes())
+        self.assertFalse((self.path/'private/failure.json').exists())
+        self.assertFalse((self.path/'private/post-publication-diagnostic.json').exists())
+        self.assert_nonretryable()
+
+    def test_prelink_error_has_only_terminal_failure(self):
+        fault = OSError('new regression: link failed before publication')
+        with patch.object(paired.os, 'link', side_effect=fault):
+            with self.assertRaises(OSError) as raised: self.finalize()
+        self.assertIs(raised.exception, fault)
+        self.assertFalse((self.path/'finalization.json').exists())
+        self.assertTrue((self.path/'finalization.candidate.json').is_file())
+        failure = json.loads((self.path/'private/failure.json').read_bytes())
+        self.assertIn('link failed before publication', failure['error'])
+        self.assertFalse((self.path/'private/post-publication-diagnostic.json').exists())
+        self.assert_nonretryable()
+
+    def test_postlink_interrupt_retains_success_and_separate_diagnostic(self):
+        link = paired.os.link
+        fault = KeyboardInterrupt('new regression: interrupt after successful link')
+        def interrupted(source, target):
+            link(source, target)
+            raise fault
+        with patch.object(paired.os, 'link', side_effect=interrupted):
+            with self.assertRaises(KeyboardInterrupt) as raised: self.finalize()
+        self.assertIs(raised.exception, fault)
+        raw = (self.path/'finalization.json').read_bytes()
+        self.assertEqual(raw, (self.path/'finalization.candidate.json').read_bytes())
+        self.assertFalse((self.path/'private/failure.json').exists())
