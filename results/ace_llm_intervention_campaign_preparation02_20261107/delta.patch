+        cls.root.mkdir(exist_ok=False)
+
+    def setUp(self):
+        self.path = self.root/self._testMethodName
+        self.path.mkdir()
+        self.result = {'cell_count': 0, 'fixture': 'publication only; not an admitted campaign'}
+        fabricated = {'policy_ids': [], 'sources': [], 'services': {}, 'scope': 'artificial', 'strata_fields': []}
+        for guard in (
+                patch.object(campaign, '_root', return_value=(fabricated, self.path)),
+                patch.object(campaign, 'summarize_screen', return_value=self.result),
+                patch.object(paired, 'finalize_paired_world', side_effect=AssertionError('no private world reporting')),
+                patch.object(paired, 'run_world_arm', side_effect=AssertionError('no arm execution')),
+                patch.object(ResponseAdapter, '__call__', side_effect=AssertionError('no environment')),
+                patch('llm_intervention_world.generate_world', side_effect=AssertionError('no world generation'))):
+            guard.start()
+            self.addCleanup(guard.stop)
+
