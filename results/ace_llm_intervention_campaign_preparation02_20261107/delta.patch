+        return campaign.finalize_campaign(campaign={}, campaign_sha256='f'*64,
+            source_plan_pins=[], output=self.path, attempt_pins={})
+
+    def assert_nonretryable(self):
+        self.assertTrue((self.path/'finalization-intent.json').is_file())
