+    def test_unexpected_published_bytes_require_reconciliation(self):
+        fault = OSError('new regression: unexpected terminal collision')
+        other = b'{"fixture":"unexpected existing receipt"}\n'
+        def conflict(path, value):
+            paired._write(path, other)
+            raise fault
+        with patch.object(paired, '_publish', side_effect=conflict):
+            with self.assertRaises(OSError) as raised: self.finalize()
+        self.assertIs(raised.exception, fault)
+        self.assertEqual((self.path/'finalization.json').read_bytes(), other)
