+        self.assertEqual(diagnostic['authority'], 'finalization.json')
+        self.assertEqual(diagnostic['expected_receipt_sha256'], paired._sha(raw))
+        self.assertEqual(diagnostic['observed_receipt_sha256'], paired._sha(raw))
+        self.assertIn('KeyboardInterrupt', diagnostic['error'])
+        self.assert_nonretryable()
