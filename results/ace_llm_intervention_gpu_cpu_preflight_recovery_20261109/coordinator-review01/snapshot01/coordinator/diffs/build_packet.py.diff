+def authenticate_gpu_recovery(ctx,supplied):
+    m,pins=ctx['metadata'],ctx['pins'];a=m['gpu-recovery-authority'];expected=m['cpu-history-expected'];c=expected['execution_context']
+    need(a['schema']=='ace-gpu-cpu-history-recovery-authority-v1' and a['status']=='operationally_adopted'
+         and a['historical_postcustody_required'] is a['unchanged_scientific_inputs'] is True
+         and a['control_root']==ROOT and a['allowed_new_output']==OUTPUT and a['failed_gpu01_root']==OLDROOT
+         and a['original_entry_sha256']==ENTRY_SHA and a['original_source_commit']==SOURCE_COMMIT
+         and a['original_gpu01_packet_sha256']==FAILED_GPU_PACKET_SHA and a['original_gpu01_job_id']==FAILED_GPU_JOB
+         and a['cpu_acceptance_sha256']==pins['cpu-acceptance'] and a['namespace_sha256']==pins['namespace-claim']
+         and a['original_namespace_sha256']==ORIGINAL_CLAIM_SHA,'explicit narrow GPU02 recovery authority required')
+    need(a['baseline']==c['baseline']==dict(sha256=pins['gpu-failure-baseline'],terminal_jobs=47,submission_journals=96),
+         'recovery context failed47/96 baseline differs')
+    need(c['control_root']==ROOT and c['gpu_output']==OUTPUT and c['failed_gpu01_root']==OLDROOT
+         and c['cpu_roots']==dict(cpu_output=CPU_ROOT+'/cpu',campaign=CPU_ROOT+'/cpu/worker/artifacts/campaign'),
+         'recovery roots differ from frozen endpoint')
+    lineage=c['lineage'];need(lineage['cpu_acceptance_sha256']==pins['cpu-acceptance']
+         and lineage['failed_gpu01_acceptance_sha256']==pins['gpu-failure-acceptance']
+         and lineage['recovery_authority_sha256']==pins['gpu-recovery-authority']
+         and lineage['namespace_sha256']==pins['namespace-claim'] and lineage['original_namespace_sha256']==ORIGINAL_CLAIM_SHA
+         and lineage['source_sha256']==a['historical_verifier_sha256']
+         and c['proof_pins']==a['historical_proof_pins']
+         and c['proof_pins']==dict(custody_sha256=pins['gpu-failure-seal'],
+             before_observation_sha256=pins['gpu-failure-inventory'],after_observation_sha256=pins['gpu-failure-inventory-after'],
+             read_set_artifact_sha256=pins['cpu-history-readset']), 'independent preflight provenance differs')
+    old=failed_gpu_history(m,pins)
+    sealed=list(m['gpu-failure-seal']['copies'].values())[0]
+    need(sealed['files']['pull_terminal.py']['sha256']==a['historical_verifier_sha256'],
+         'preflight historical verifier is not the original sealed collector')
+    # Join expected full maps to the actual accepted byte observation; no outcome decoding.
+    files=ctx['observations']['cpu']['files'];directories=ctx['observations']['cpu']['directories']
+    for label,prefix in [('cpu_output','launch/cpu/'),('campaign','launch/cpu/worker/artifacts/campaign/')]:
+        subset={n[len(prefix):]:v for n,v in files.items() if n.startswith(prefix)}
+        dirs=[n[len(prefix):] for n in directories if n.startswith(prefix)]
+        if label=='cpu_output':
+            sub='worker/artifacts/campaign';subset={n:v for n,v in subset.items() if not n.startswith(sub+'/')}
+            dirs=[n for n in dirs if n!=sub and not n.startswith(sub+'/')]
+        need(expected['cpu_inventories'][label]==exact_inventory(subset,dirs),'context full CPU map differs')
+    manifest=m['operational-source-manifest']
+    need(set(manifest)=={'schema','source_commit','files'} and manifest['schema']=='ace-gpu02-operational-sources-v1'
+         and set(manifest['files'])=={ENTRY,PREFLIGHT,HISTORY},'exact three operational source captures required')
+    captured={}
+    for n,v in manifest['files'].items():
+        need(set(v)=={'repository_path','sha256'} and pin(v['sha256']),'operational source identity required')
+        safe_relative(v['repository_path']);captured[n]=committed(manifest['source_commit'],v['repository_path'])
+        need(sha(captured[n])==v['sha256'],'independently supplied committed operational source differs')
+    need(lineage['checker_sha256']==sha(captured[PREFLIGHT]),'independently pinned preflight checker differs')
+    need(c['model_files_sha256']==digest(m['freeze']['model_files']) and c['resources_sha256']==digest(RESOURCES)
+         and c['limits_sha256']==digest(LIMITS),'recovery immutable model/resource/clock context differs')
+    # Pure supplied-bytes checker only. No scientific modules imported or executed.
+    checker=types.ModuleType('captured_cpu_preflight');exec(compile(captured[PREFLIGHT],PREFLIGHT,'exec'),vars(checker))
+    scoped=checker.validate_receipt(supplied['cpu-history-preflight'],pins['cpu-history-preflight'],
+                                    supplied['cpu-history-expected'],pins['cpu-history-expected'])
+    need(scoped['full_external_postcustody_required'] is True,'receipt cannot replace postcustody')
+    ctx['operational_sources']=captured;ctx['failed_gpu_inventory']=old
+    ctx['gpu_recovery']=dict(authority_sha256=pins['gpu-recovery-authority'],review_sha256=pins['gpu-recovery-review'],
+        operational_source_review_sha256=pins['operational-source-review'],preflight_review_sha256=pins['preflight-review'],
+        failure_acceptance_sha256=pins['gpu-failure-acceptance'],failure_seal_sha256=pins['gpu-failure-seal'],
+        failure_disposition_sha256=pins['gpu-failure-disposition'],failed_root=OLDROOT,failed_job_id=FAILED_GPU_JOB,
+        control_root=ROOT,output_root=OUTPUT,preflight_receipt_sha256=pins['cpu-history-preflight'],
+        execution_context_sha256=expected['execution_context_sha256'],old_root_inventory_sha256=digest(old),
+        historical_postcustody_required=True,original_collector_status=m['gpu-failure-disposition']['status'])
