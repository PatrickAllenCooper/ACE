+def inject_recovery(ctx,data,supplied,original_sources):
+    m=ctx['metadata'];a=m['gpu-recovery-authority'];captured=ctx['operational_sources'];old=m['cpu-packet']
+    need(ENTRY not in old['files'] and not {PREFLIGHT,HISTORY}&set(data),'recovery must not replace any original95 CPU input')
+    derived=captured[ENTRY];need(literal(derived,'VERSION')==VERSION and literal(derived,'RECOVERY_FILES')==RECOVERY_FILES
+         and literal(derived,'EXTRA_SOURCES')==literal(data[ENTRY],'EXTRA_SOURCES')|{PREFLIGHT,HISTORY}
+         and literal(derived,'PREFLIGHT_SHA')==sha(captured[PREFLIGHT])
+         and literal(derived,'HISTORY_SHA')==sha(captured[HISTORY]),'exact reviewed operational entry/helper closure differs')
+    data=dict(data);data.update(captured)
+    for role,n in RECOVERY_FILES.items():data[n]=supplied[n[:-5]]
+    sources=sorted(set(original_sources)|{PREFLIGHT,HISTORY});source_pins={n:sha(data[n]) for n in sources}
+    need(source_pins==a['operational_source_files'] and digest(source_pins)==m['cpu-history-expected']['execution_context']['source_files_sha256'],
+         'complete operational source roster/context differs')
+    need(all(sha(data[n])==h for n,h in old['files'].items()),'original95 CPU bytes changed')
+    return data,sources
