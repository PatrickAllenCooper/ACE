+@contextlib.contextmanager
+def termination_guard():
+    def terminate(signum,frame):
+        raise TerminationRequested('SIGTERM requested bounded owned cleanup')
+    previous=signal.signal(signal.SIGTERM,terminate)
+    try:yield
+    finally:signal.signal(signal.SIGTERM,previous)
+
+@contextlib.contextmanager
+def cleanup_signals(primary):
+    """Defer another SIGTERM until cleanup finishes; never replace its primary."""
+    pending=[];error=primary
+    previous=signal.signal(signal.SIGTERM,lambda signum,frame:pending.append(signum))
+    try:
+        yield
+    except BaseException as exc:
+        error=exc;raise
+    finally:
+        signal.signal(signal.SIGTERM,previous)
+        if pending and error is not None and hasattr(error,'add_note'):
+            error.add_note('Additional SIGTERM deferred during owned cleanup')
+    if pending and error is None:raise TerminationRequested('SIGTERM deferred until owned cleanup completed')
