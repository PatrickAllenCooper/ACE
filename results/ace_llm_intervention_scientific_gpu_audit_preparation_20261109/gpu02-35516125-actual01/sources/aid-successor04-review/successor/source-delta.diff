+def output_path_proof(proof, info, packet, cpu, old_packet, prior_files, current_files):
+    """Derive one exact recorded root from independently accepted saved CPU proof.
+
+    Never resolve remote paths locally, substitute a generic prefix, or infer
+    live alias/namespace/runtime qualification from this historical record.
+    """
+    producer='prepare_llm_intervention_scientific_campaign_cpu.py'
+    producer_pin='ba439d819f49f6832c97181e4ff727c4813f29031e7b67f8085670f845b0f893'
+    need(packet['files'].get(producer)==producer_pin, 'accepted path-binding producer differs')
+    need(set(info)=={'bytes','sha256'} and type(info['bytes']) is int and info['bytes']>0,
+         'exact saved path-binding byte identity required')
+    need(set(proof)=={'schema','packet_sha256','resources','deadlines','retry_allowed','output_path_binding'}
+         and proof['schema']==old_packet['schema']
+         and proof['packet_sha256']==packet['cpu_packet_sha256']==cpu['cpu_packet_sha256']
+         and proof['resources']==old_packet['resources'] and proof['deadlines']==old_packet['deadlines']
+         and proof['retry_allowed'] is False, 'accepted CPU start schema/packet contract differs')
+    for name in ('start.json','worker/start.json'):
+        need(cpu['cpu_output_files'].get(name)==info['sha256']
+             and prior_files.get('launch/cpu/'+name)==info
+             and current_files.get('cpu/cpu/'+name)==info,
+             'both accepted CPU start proofs must survive full current custody')
+    binding=proof['output_path_binding']
+    need(set(binding)=={'logical','resolved','mount_alias','root_device','root_inode'}
+         and binding['mount_alias'] is True
+         and type(binding['root_device']) is int and binding['root_device']>=0
+         and type(binding['root_inode']) is int and binding['root_inode']>0,
+         'exact saved accepted mount binding required')
+    logical=PurePosixPath(binding['logical']);resolved=PurePosixPath(binding['resolved'])
+    need(logical.is_absolute() and resolved.is_absolute()
+         and str(logical)==binding['logical'] and str(resolved)==binding['resolved']
+         and '..' not in logical.parts and '..' not in resolved.parts,
+         'normalized absolute saved root spellings required')
+    logical_mount=PurePosixPath('/scratch/alpine');physical_mount=PurePosixPath('/gpfs/alpine1/scratch')
+    need(logical_mount in logical.parents
+         and resolved==physical_mount/logical.relative_to(logical_mount),
+         'saved resolution differs from the frozen producer exact mount contract')
+    need(str(logical)==packet['paths']['cpu_output']==old_packet['cpu_output']==cpu['cpu_output'],
+         'accepted resolved proof belongs to another logical CPU output')
+    suffix='worker/artifacts/campaign'
+    need(str(logical/suffix)==packet['paths']['campaign']==cpu['campaign_root'],
+         'accepted logical campaign endpoint differs')
+    return dict(logical_cpu_output=str(logical),resolved_cpu_output=str(resolved),
+                logical_campaign_root=str(logical/suffix),resolved_campaign_root=str(resolved/suffix),
+                proof_sha256=info['sha256'],producer_sha256=producer_pin,
+                root_device=binding['root_device'],root_inode=binding['root_inode'],
+                scope='accepted_saved_CPU_path_binding_plus_current_full_custody',
+                acceptance=False,live_resolution_performed=False)
 
 
